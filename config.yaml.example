# Gateway Proxy 配置示例

port: "8080"
db_path: "gateway.db"

# Admin Key（可查询所有统计）
admin_key: "sk-admin-xxxxx"

# Provider 配置
providers:
  minimax:
    api_base: "https://api.minimaxi.com/v1"
    api_key: "sk-cp-xxx"
    models:
      - "MiniMax-M2.7"
      - "MiniMax-M2.5"

  zhipu:
    api_base: "https://open.bigmodel.cn/api/paas/v4"
    api_key: "your-zhipu-key"
    models:
      - "glm-4"
      - "glm-4-flash"

  openai:
    api_base: "https://api.openai.com/v1"
    api_key: "sk-xxx"
    models:
      - "gpt-4o"
      - "gpt-4o-mini"

  anthropic:
    api_base: "https://api.anthropic.com/v1"
    api_key: "sk-ant-xxx"
    models:
      - "claude-3-5-sonnet-latest"
      - "claude-3-haiku-latest"

  # Codex (ChatGPT Plus/Pro) — auto-reads ~/.codex/auth.json
  codex:
    api_base: "https://chatgpt.com/backend-api/codex"
    models:
      - "gpt-5.4"
    auth_type: "codex"

# Key 路由配置
keys:
  - key: "sk-user1-minimax"
    alias: "用户1-MiniMax"
    provider: "minimax"
    models: []  # 空数组表示不限制

  - key: "sk-user1-zhipu"
    alias: "用户1-智谱"
    provider: "zhipu"
    models: []

  - key: "sk-user1-openai"
    alias: "用户1-OpenAI"
    provider: "openai"
    models: []

  - key: "sk-user1-anthropic"
    alias: "用户1-Claude"
    provider: "anthropic"
    models: []
